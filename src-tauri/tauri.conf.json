{
  "productName": "ngodik",
  "version": "0.1.0",
  "identifier": "id.ngodik.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "ngodik", "width": 1100, "height": 720, "minWidth": 640, "minHeight": 480 }],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico"] }
}
